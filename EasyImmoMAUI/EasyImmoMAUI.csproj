<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>-->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>EasyImmoMAUI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>EasyImmoMAUI</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.easyimmomaui</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!--<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>-->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<!--<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>-->
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône principale de l'application -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />

		<!-- Toutes les images du projet -->
		<MauiImage Include="Resources\Images\**\*" />

		<!-- Toutes les icônes utilisables dans l'interface -->
		<MauiImage Include="Resources\AppIcon\**\*" Exclude="Resources\AppIcon\appicon.svg" />

		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Views\EvenementView\**" />
	  <EmbeddedResource Remove="Views\EvenementView\**" />
	  <MauiCss Remove="Views\EvenementView\**" />
	  <MauiXaml Remove="Views\EvenementView\**" />
	  <None Remove="Views\EvenementView\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BU\BU.csproj" />
		<ProjectReference Include="..\Common\Common.csproj" />
		<ProjectReference Include="..\DAL\DAL.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\BiensViews\EditerBienPage.xaml.cs">
		  <DependentUpon>EditerBienPage.xaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\StatusBadgeView.xaml.cs">
		  <DependentUpon>StatusBadgeView.xaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Components\SidebarView.xaml.cs">
			<DependentUpon>SidebarView.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\Components\StatCardView.xaml.cs">
			<DependentUpon>StatCardView.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\EvenementsView\EvenementsPage.xaml.cs">
		  <DependentUpon>EvenementsPage.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\PersonnesView\AjouterPersonnePage.xaml.cs">
		  <DependentUpon>AjouterPersonnePage.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\PersonnesView\EditerPersonnePage.xaml.cs">
		  <DependentUpon>EditerPersonnePage.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\PersonnesView\PersonnesPage.xaml.cs">
		  <DependentUpon>PersonnesPage.xaml</DependentUpon>
		</Compile>

		<Compile Update="Views\ReglagesView\ReglagesPage.xaml.cs">
		  <DependentUpon>ReglagesPage.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\BiensViews\AjouterBienPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\BiensViews\EditerBienPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\Components\BienCardView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\Components\Buttons\DeleteButton.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\Components\Buttons\PrimaryButton.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\Components\Buttons\SecondaryButton.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\Components\StatusBadgeView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\Components\SidebarView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\Components\StatCardView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\DashboardPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\BiensViews\BiensPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\BiensViews\DetailBienPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\EvenementsView\EvenementsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\PersonnesView\AjouterPersonnePage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\PersonnesView\EditerPersonnePage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\PersonnesView\PersonnesPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>

		<MauiXaml Update="Views\ReglagesView\ReglagesPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <PRIResource Remove="Views\EvenementView\**" />
	</ItemGroup>

</Project>
