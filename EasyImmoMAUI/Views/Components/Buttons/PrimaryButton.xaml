<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:EasyImmoMAUI.Views.Components"
    x:Class="EasyImmoMAUI.Views.Components.Buttons.PrimaryButton"
    x:Name="Root">

    <Button
        Text="{Binding ButtonText, Source={x:Reference Root}}"
        Clicked="OnButtonClicked"
        BackgroundColor="#4F63FF"
        TextColor="White"
        FontAttributes="Bold"
        CornerRadius="16"
        Padding="20,12"
        VerticalOptions="Center" />

</ContentView>