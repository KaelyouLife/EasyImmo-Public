<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyImmoMAUI.Views.Components.StatCardView"
    x:Name="Root">

    <Border Style="{StaticResource Card}">

        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="48,*"
              RowSpacing="10"
              ColumnSpacing="14">

            <Image Grid.Row="0" Grid.Column="0"
                   Source="{Binding Source={x:Reference Root}, Path=IconSource}"
                   WidthRequest="34"
                   HeightRequest="34"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Grid.Row="0" Grid.Column="1"
                   Text="{Binding Source={x:Reference Root}, Path=Value}"
                   VerticalOptions="Center"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AppTextPrimary}" />

            <Label Grid.Row="1" Grid.ColumnSpan="2"
                   Text="{Binding Source={x:Reference Root}, Path=Label}"
                   Style="{StaticResource SecondaryText}" />
        </Grid>
    </Border>
</ContentView>
